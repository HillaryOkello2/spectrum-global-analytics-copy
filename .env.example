APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. The local default writes messages to storage/logs instead of sending.
# For SendGrid, use its SMTP relay — no extra package is needed:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USERNAME=apikey            (literally the word "apikey")
#   MAIL_PASSWORD=<SendGrid API key>
# MAIL_FROM_ADDRESS must be a sender identity SendGrid has verified, or it
# rejects the mail. APP_NAME is the brand shown in every email's subject.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend apps that emailed links point at (sign-in, password reset). Staff
# are sent to the admin portal, subscribers to the subscriber portal.
FRONTEND_ADMIN_URL=http://localhost:3002
FRONTEND_SUBSCRIBER_URL=http://localhost:3001
# FRONTEND_LOGIN_PATH=/login
# FRONTEND_RESET_PASSWORD_PATH=/reset-password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Payments (PGW driver pending API docs; "fake" for local/UAT) ---
PAYMENT_GATEWAY=fake
PGW_BASE_URL=
PGW_API_KEY=
PGW_CALLBACK_SECRET=

# --- LLM providers (LLM_FAKE=true stubs all six locally) ---
LLM_FAKE=true
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# Output ceiling and per-request timeout. The defaults (per-vendor max_tokens,
# 600s) suit the client's long-form prompts; set these only to override.
# LLM_MAX_TOKENS=
# LLM_TIMEOUT=600

# Claude reasoning. Left disabled: on Sonnet 5 thinking is on by default, shares
# the max_tokens budget with the answer, and can consume all of it — returning a
# thinking block and no text. Set to `adaptive` (with ANTHROPIC_EFFORT
# low|medium|high) to turn it back on with a bound.
# ANTHROPIC_THINKING=disabled
# ANTHROPIC_EFFORT=medium

# DeepSeek and Moonshot reasoning. Same trap: on by default, paid out of
# max_tokens, and it can use the whole budget before writing anything —
# DeepSeek V4 Pro spent all 8,000 on a CC brief, Kimi K2.6 15,999 of 16,000
# on an ES essay. Left disabled; set to `enabled` to turn it back on.
# DEEPSEEK_THINKING=disabled
# MOONSHOT_THINKING=disabled

# Gemini reasoning. Same trap, but gemini-3.7-flash has no off switch, so it
# is capped instead: at most this many thinking tokens per request. A budget
# of 0 does NOT turn it off on 3.7-flash (it is ignored), and on 3.6-flash it
# is rejected outright. Leave empty for the model's own default.
# GEMINI_THINKING_BUDGET=2048

# Second review stage: a redacted copy for subscribers whose tier withholds the
# full document. Off — proofreading approves outright. With it off, a withheld
# subscriber sees the abstract instead of a censored document.
PUBLISHING_REDACTION=false

# API-only lockdown. When on, anything outside API_ONLY_ALLOWED_PATHS returns a
# 404 before routing — this hides the Horizon dashboard, the Scribe docs, the
# storage route and the root banner from the public internet.
#
# ⚠️ TEMPORARILY DEFAULTED OFF (2026-08-04) while debugging frontend
# connectivity. Set API_ONLY=true to switch it back on for a single host without
# a deploy; see the note in config/security.php to restore the old default.
API_ONLY=
API_ONLY_STATUS=404
API_ONLY_ALLOWED_PATHS=api/*,up

# Comma-separated browser origins allowed to call the API (CORS).
#
# ⚠️ TEMPORARILY OPEN TO ALL ORIGINS (2026-08-04) while debugging frontend
# connectivity. Setting this REPLACES the wide-open default entirely — include
# every origin you need, with scheme and no trailing slash. To lock the deployed
# host back down without a code change:
#   CORS_ALLOWED_ORIGINS=https://demo.sga.techbizafrica.com
CORS_ALLOWED_ORIGINS=
